# ============================================================
# GeoCore Academy — KZ (geocore-academy.kz) Environment
# Копия .env.example с правками под Казахстан. На KZ-VPS:
#   cp .env.kz.example .env   (секреты подставить из Bitwarden — источник правды)
#
# ⚠️ ЭТО ШАБЛОН, он в git. Реальные значения — только в .env на сервере и в
#    Bitwarden. Заполненный .env.kz добавлен в .gitignore, чтобы секреты не
#    уехали в репозиторий.
#
# ⚠️ ОТЛИЧИЯ ОТ .env (RU), помечены [KZ]:
#   - MOODLE_WWWROOT / домены → .kz
#   - SMTP / admin email → .kz (после переноса почты на Яндекс 360 для .kz)
#   - Telegram-прокси НЕ нужен (в КЗ Telegram не блокируется) — см. низ файла
#   - S3-бэкапы ОСТАЮТСЯ на Selectel ru-3 (решение: S3 в RU) — не меняем
# ============================================================

# Docker Hub (образы те же, pipeline не меняется)
DOCKERHUB_USER=andreyhiitola
MOODLE_VERSION=5.1.3

# --- База данных (пароли — те же, что на RU, чтобы дамп импортировался как есть) ---
DB_ROOT_PASSWORD=change_me_strong_root_password
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=change_me_strong_db_password

# --- Moodle настройки ---
MOODLE_WWWROOT=https://courses.geocore-academy.kz          # [KZ]
MOODLE_SITE_NAME=GeoCore Academy
MOODLE_SITE_SHORTNAME=geocore
MOODLE_LANG=ru

# --- Moodle администратор ---
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASS=change_me_Admin1234
MOODLE_ADMIN_EMAIL=admin@geocore-academy.kz               # [KZ]

# --- [KZ] Регион: домен и контакты ---
# RU и KZ крутят ОДИН И ТОТ ЖЕ образ frontend — контент разделяется только через
# эти env. SITE_DOMAIN подменяет базовый домен во всей статике при старте
# контейнера (courses.*, api.*, mailto:*) — см. frontend/docker-entrypoint.d/.
# На RU эти переменные не задаются, дефолт = .ru, продд не затронут.
SITE_DOMAIN=geocore-academy.kz
CONTACT_EMAIL=info@geocore-academy.kz
CONTACT_SITE=geocore-academy.kz
# CORS бэкенда: раньше был прибит гвоздями к https://geocore-academy.ru и
# отшивал KZ-фронт.
ALLOWED_ORIGINS=https://geocore-academy.kz

# --- Backend API ---
API_SECRET_KEY=change_me_random_secret_key_32chars
MAX_CSV_BYTES=5242880
MAX_CSV_ROWS=20000

# --- Moodle Web Service Token (переносится вместе с БД; если ломается — перевыпустить) ---
MOODLE_TOKEN=

# --- Реквизиты для счетов на оплату ---
INVOICE_COMPANY_NAME=
INVOICE_INN=
INVOICE_KPP=
INVOICE_BANK=
INVOICE_BIK=
INVOICE_ACCOUNT=
INVOICE_CORR_ACCOUNT=
INVOICE_ADDRESS=

# --- Email уведомления ---
# [KZ] Zoho Mail Lite, отдельная организация под .kz, ДЦ .com (mailadmin.zoho.com).
#      Один платный пользователь info@ + алиасы admin@ и bortsov@.
#      SMTP_PASS — App Password из Zoho (не пароль от аккаунта): Zoho Mail →
#      Settings → Security → App Passwords. Значение только в Bitwarden и .env.
#      Отправка идёт от SMTP_USER, поэтому это должен быть ящик, а не алиас.
SMTP_HOST=smtp.zoho.com                                   # [KZ] был smtp.yandex.ru
SMTP_PORT=587                                             # STARTTLS
SMTP_USER=info@geocore-academy.kz                         # [KZ]
SMTP_PASS=
# Куда падают заявки с сайта. Раньше был gmail-костыль — с платным Zoho не нужен.
NOTIFY_EMAIL=info@geocore-academy.kz                      # [KZ]

# --- Бэкапы (Selectel S3) — у KZ СВОЙ бакет ---
# ⚠️ НИКОГДА не ставить сюда geocore-backups (бакет RU): ключи daily/monthly
#    завязаны только на дату, а `s3 sync --delete` в moodledata-mirror/ снесёт
#    зеркало другого региона. Бакет geocore-backups-kz создан 19.07.2026
#    (ru-3, versioning + Object Lock без default-правила).
# Ключи: сервисный пользователь Selectel с ролью s3.admin на My First Project,
#    S3-ключ "geocore-kz-backup". Значения — в Bitwarden, не коммитить.
S3_ENDPOINT=https://s3.ru-3.storage.selcloud.ru
S3_BUCKET=geocore-backups-kz
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ru-3

# --- Мониторинг (Telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# [KZ] Прокси для Telegram НЕ НУЖЕН — в Казахстане Telegram доступен напрямую.
#      Оставляем пустыми (в RU здесь был SOCKS5-туннель до severen):
HTTPS_PROXY=
BACKUP_TELEGRAM_PROXY=

# --- AI-ассистент (OpenRouter) ---
OPENROUTER_API_KEY=

# --- Админка ---
ADMIN_USERNAME=admin
ADMIN_TOKEN=change_me_strong_admin_token
GITHUB_TOKEN=
GITHUB_REPO=Andreyhiitola/geocore
