# ============================================================
# GeoCore Academy — Production Environment Variables
# Скопировать в .env и заполнить реальными значениями:
#   cp .env.example .env
# ============================================================

# Docker Hub (имя пользователя, куда пушим образы)
DOCKERHUB_USER=andreyhiitola

# Версия Moodle (должна совпадать с тегом образа на Docker Hub)
# Для обновления: 1) протестировать в docker-compose.test.yml
#                 2) изменить здесь + пересобрать образ
MOODLE_VERSION=5.1.3

# --- База данных ---
DB_ROOT_PASSWORD=change_me_strong_root_password
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=change_me_strong_db_password

# --- Moodle настройки ---
MOODLE_WWWROOT=https://courses.geocore-academy.ru
MOODLE_SITE_NAME=GeoCore Academy
MOODLE_SITE_SHORTNAME=geocore
MOODLE_LANG=ru

# --- Moodle администратор ---
# Пароль должен содержать: буквы + цифры, минимум 8 символов
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASS=change_me_Admin1234
MOODLE_ADMIN_EMAIL=admin@geocore-academy.ru

# --- Backend API ---
API_SECRET_KEY=change_me_random_secret_key_32chars

# --- Moodle Web Service Token ---
# Получить в Moodle: Администрирование → Плагины → Web services → Управление токенами
# Нужна функция: core_course_get_courses
MOODLE_TOKEN=

# --- Email уведомления о заявках ---
# Отправитель: noreply@geocore-academy.ru через Яндекс 360 для бизнеса (бесплатно)
# Инструкция: https://360.yandex.ru/business → подключить домен geocore-academy.ru
# SMTP_PASS: пароль приложения из Яндекс 360 → Безопасность → Пароли приложений
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=noreply@geocore-academy.ru
SMTP_PASS=
NOTIFY_EMAIL=9624294@gmail.com

# --- Админка ---
# Придумай любой сложный пароль — это ключ входа в admin.html
ADMIN_TOKEN=change_me_strong_admin_token
# GitHub Personal Access Token с правом repo (Contents: read & write)
# Создать: GitHub → Settings → Developer settings → Personal access tokens → Fine-grained
GITHUB_TOKEN=
GITHUB_REPO=Andreyhiitola/geocore
