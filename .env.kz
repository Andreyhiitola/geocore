# ============================================================
# GeoCore Academy — KZ (geocore-academy.kz) Environment
# Копия .env.example с правками под Казахстан. На KZ-VPS:
#   cp .env.kz .env   (секреты подставить из Bitwarden — источник правды)
#
# ⚠️ ОТЛИЧИЯ ОТ .env (RU), помечены [KZ]:
#   - MOODLE_WWWROOT / домены → .kz
#   - SMTP / admin email → .kz (после переноса почты на Яндекс 360 для .kz)
#   - Telegram-прокси НЕ нужен (в КЗ Telegram не блокируется) — см. низ файла
#   - S3-бэкапы ОСТАЮТСЯ на Selectel ru-3 (решение: S3 в RU) — не меняем
# ============================================================

# Docker Hub (образы те же, pipeline не меняется)
DOCKERHUB_USER=andreyhiitola
MOODLE_VERSION=5.1.3

# --- База данных (пароли — те же, что на RU, чтобы дамп импортировался как есть) ---
DB_ROOT_PASSWORD=change_me_strong_root_password
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=change_me_strong_db_password

# --- Moodle настройки ---
MOODLE_WWWROOT=https://courses.geocore-academy.kz          # [KZ]
MOODLE_SITE_NAME=GeoCore Academy
MOODLE_SITE_SHORTNAME=geocore
MOODLE_LANG=ru

# --- Moodle администратор ---
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASS=change_me_Admin1234
MOODLE_ADMIN_EMAIL=admin@geocore-academy.kz               # [KZ]

# --- Backend API ---
API_SECRET_KEY=change_me_random_secret_key_32chars
MAX_CSV_BYTES=5242880
MAX_CSV_ROWS=20000

# --- Moodle Web Service Token (переносится вместе с БД; если ломается — перевыпустить) ---
MOODLE_TOKEN=

# --- Реквизиты для счетов на оплату ---
INVOICE_COMPANY_NAME=
INVOICE_INN=
INVOICE_KPP=
INVOICE_BANK=
INVOICE_BIK=
INVOICE_ACCOUNT=
INVOICE_CORR_ACCOUNT=
INVOICE_ADDRESS=

# --- Email уведомления ---
# [KZ] После переноса почты на geocore-academy.kz (Яндекс 360 → подключить домен .kz,
#      настроить MX/SPF/DKIM, выпустить пароль приложения). До переноса можно временно
#      оставить noreply@geocore-academy.ru.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=noreply@geocore-academy.kz                      # [KZ]
SMTP_PASS=
NOTIFY_EMAIL=9624294@gmail.com

# --- Бэкапы (Selectel S3) — ОСТАЮТСЯ В RU, не меняем ---
# ⚠️ На ЗЕРКАЛЕ backup-контейнер держать ВЫКЛЮЧЕННЫМ до переключения трафика,
#    иначе два сервера пишут в один бакет (коллизия). Включить только когда KZ
#    станет основным (тогда выключить backup на RU).
S3_ENDPOINT=https://s3.ru-3.storage.selcloud.ru
S3_BUCKET=geocore-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ru-3

# --- Мониторинг (Telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# [KZ] Прокси для Telegram НЕ НУЖЕН — в Казахстане Telegram доступен напрямую.
#      Оставляем пустыми (в RU здесь был SOCKS5-туннель до severen):
HTTPS_PROXY=
BACKUP_TELEGRAM_PROXY=

# --- AI-ассистент (OpenRouter) ---
OPENROUTER_API_KEY=

# --- Админка ---
ADMIN_USERNAME=admin
ADMIN_TOKEN=change_me_strong_admin_token
GITHUB_TOKEN=
GITHUB_REPO=Andreyhiitola/geocore
